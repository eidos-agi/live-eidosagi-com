# Shared secret required by POST /api/ingest (header X-Ingest-Token).
# Generate with: openssl rand -hex 32
INGEST_TOKEN=

# Public site URL for canonical/OG tags.
NEXT_PUBLIC_SITE_URL=https://live.eidosagi.com

# Postgres connection string used by the Activity Stream page (/activity)
# and the /api/events endpoint. Schema lives in the sister repo
# eidos-live-mcp/migrations/001_init.sql (events table).
# If unset, the feed renders empty rather than erroring.
DATABASE_URL=

# Set to "false" to disable SSL (local postgres). Defaults to SSL on.
DATABASE_SSL=
