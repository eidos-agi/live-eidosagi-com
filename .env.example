# Shared secret required by POST /api/ingest (header X-Ingest-Token).
# Generate with: openssl rand -hex 32
INGEST_TOKEN=

# Public site URL for canonical/OG tags.
NEXT_PUBLIC_SITE_URL=https://live.eidosagi.com

# Where the SQLite database file lives.
# In production the default /data path lands on a Railway persistent volume.
# For local dev, point this at a relative path outside the repo root:
#   DATABASE_PATH=./data/eidos-live.sqlite
DATABASE_PATH=/data/eidos-live.sqlite

# Shared secret for the GitHub webhook (POST /api/github-webhook).
# Configure the same value in the repository webhook settings.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Salt used to hash visitor IPs for the public chat sidebar. Raw IPs are
# never stored — we only store SHA-256(ip + CHAT_IP_SALT) for rate-limiting.
# Required in production. Generate with: openssl rand -hex 32
CHAT_IP_SALT=

# Assumed mean $/event for hosted Claude (used by /api/savings).
# Keep this conservative — the savings number should only ever round DOWN.
CLAUDE_EVENT_COST_USD=0.004
